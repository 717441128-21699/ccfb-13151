{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mahjong-platform/schemas/rule-pack.schema.json",
  "title": "地方麻将规则包",
  "type": "object",
  "required": ["version", "id", "name", "region", "wall", "wildcard", "winStructures", "claim", "fans", "scoring", "requirements"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "region": { "type": "string" },
    "wall": {
      "type": "object",
      "required": ["copiesPerTile", "flowerTiles"],
      "properties": {
        "copiesPerTile": { "type": "integer", "minimum": 1, "maximum": 4 },
        "flowerTiles": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 33 } }
      }
    },
    "wildcard": {
      "type": "object",
      "required": ["enabled", "naturalId", "maxCount", "allowAsNatural"],
      "properties": {
        "enabled": { "type": "boolean" },
        "naturalId": { "type": ["integer", "null"], "minimum": 0, "maximum": 33 },
        "maxCount": { "type": "integer", "minimum": 0, "maximum": 4 },
        "allowAsNatural": { "type": "boolean" }
      }
    },
    "winStructures": {
      "type": "object",
      "required": ["standard", "sevenPairs", "thirteenOrphans", "allowQuadInSevenPairs"],
      "properties": {
        "standard": { "type": "boolean" },
        "sevenPairs": { "type": "boolean" },
        "thirteenOrphans": { "type": "boolean" },
        "allowQuadInSevenPairs": { "type": "boolean" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["order", "multiWin", "robbingKong", "lastTileBonus", "supplementKong"],
      "properties": {
        "order": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["chow", "pung", "concealedKong", "exposedKong", "win"] }
        },
        "multiWin": { "type": "boolean" },
        "robbingKong": { "type": "boolean" },
        "lastTileBonus": { "type": "boolean" },
        "supplementKong": { "type": "boolean" }
      }
    },
    "fans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "predicate", "value"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "predicate": { "type": "string" },
          "params": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
          "value": { "type": "number", "exclusiveMinimum": 0 },
          "includes": { "type": "array", "items": { "type": "string" } },
          "mutexGroup": { "type": "string" },
          "requireNoWildcard": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": ["mode", "cap", "minFan"],
      "properties": {
        "mode": { "enum": ["additive", "multiplicative"] },
        "cap": { "type": ["integer", "null"] },
        "minFan": { "type": "integer", "minimum": 0 },
        "baseScore": { "type": "number" }
      }
    },
    "requirements": {
      "type": "object",
      "required": ["requireMissingSuit"],
      "properties": { "requireMissingSuit": { "type": "boolean" } }
    },
    "documentation": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
